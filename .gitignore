# Файлы, которые git не должен отправлять на GitHub.
# Репозиторий публичный — всё, что сюда не попало, увидят все.

# База данных: аккаунты, хеши паролей, заказы с телефонами, сообщения
*.db
*.db-journal
*.db-wal
*.db-shm

# Фото, которые загрузили пользователи через «Продать»
images/uploads/

# Окружение Python и его кэш — у каждого компьютера своё, ставится из requirements.txt
.venv/
__pycache__/

# Скачанные программы (cloudflared.exe — 50 МБ) и журналы
tools/
*.log

# Локальные настройки Claude с путями на этом компьютере
.claude/
