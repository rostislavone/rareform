# Caddy — веб-сервер «на входе». Он:
# - сам получает и продлевает HTTPS-сертификат (замочек в браузере), бесплатно, через Let's Encrypt;
# - перенаправляет http:// на https://;
# - передаёт запросы нашему сайту, который слушает 127.0.0.1:8000.
# Файл кладётся в /etc/caddy/Caddyfile. ДОМЕН заменяется на настоящий при установке.

ДОМЕН, www.ДОМЕН {
	# Сжатие ответов — страницы грузятся быстрее
	encode zstd gzip

	# Не принимаем запросы больше 20 МБ ещё до того, как они дойдут до сайта
	request_body {
		max_size 20MB
	}

	# HSTS: браузер запомнит, что сайт открывается только по https
	header Strict-Transport-Security "max-age=31536000"

	reverse_proxy 127.0.0.1:8000
}
